{
  "RateLimits": {
    "passive_source_requests_per_second": 1.0,
    "dns_queries_per_second": 4.0,
    "dns_worker_count": 8,
    "http_delay_seconds": 2.0,
    "http_max_requests_per_host": 6,
    "crawler_max_pages_per_origin": 6,
    "crawler_max_total_pages": 150,
    "crawler_max_depth": 1,
    "external_js_max_files": 2,
    "nmap_max_parallel_processes": 1,
    "nmap_max_rate_per_process": 10,
    "nmap_max_targets": 500,
    "masscan_rate": 100,
    "global_max_requests_per_second": 1.0,
    "http_max_concurrency": 2,
    "http_max_concurrency_per_origin": 1,
    "http_start_interval_seconds": 2.0,
    "browser_navigation_timeout_seconds": 10.0,
    "browser_screenshot_timeout_seconds": 10.0,
    "browser_target_total_timeout_seconds": 20.0,
    "browser_dom_settle_milliseconds": 500,
    "screenshot_max_concurrency": 1
  },
  "CollectionPolicy": {
    "passive_provider_profile": "standard",
    "passive_inventory_safety_cap": 250000,
    "dns_candidate_budget": 1000,
    "passive_max_ips": 100,
    "internetdb_enabled": true,
    "crt_name_enabled": true,
    "thc_enabled": true,
    "submd_fallback_enabled": true,
    "crtsh_enabled": true,
    "certspotter_enabled": true,
    "passive_source_retries": 3,
    "passive_cache_ttl_hours": 24,
    "passive_connect_timeout_seconds": 10.0,
    "passive_read_timeout_seconds": 45.0,
    "crt_name_connect_timeout_seconds": 10.0,
    "crt_name_read_timeout_seconds": 300.0,
    "wildcard_enabled": true,
    "wildcard_probes_per_parent": 3,
    "wildcard_max_parent_zones": 2000,
    "wildcard_min_candidates_per_parent": 1,
    "include_wildcard_ambiguous_active": false,
    "stop_on_http_statuses": [
      401,
      403,
      429
    ],
    "nmap_service_detection": false,
    "obey_robots": true,
    "follow_meta_nofollow": false,
    "block_out_of_scope_browser_requests": true,
    "web_primary_domain_only": false,
    "streaming_pipeline_enabled": true,
    "dynamic_discovery_from_html": true,
    "dynamic_discovery_max_rounds": 2,
    "dynamic_discovery_max_new_domains": 100,
    "http_fallback_after_timeout": false
  },
  "Modules": {
    "subdomains": true,
    "domain_expansion": true,
    "port_scan": true,
    "masscan": false,
    "web_probe": false,
    "crawler": false,
    "screenshots": false,
    "pdf_report": true,
    "ai_review": false
  },
  "ReportingConfig": {
    "language": "en",
    "full_report": false,
    "domain_rows": 200,
    "ip_rows": 200,
    "routing_rows": 50,
    "related_domain_rows": 50,
    "port_rows": 100,
    "web_coverage_rows": 100,
    "web_rows": 40,
    "document_rows": 50,
    "screenshot_rows": 30
  },
  "BackendsConfig": {
    "serialization_backend": "orjson",
    "schema_backend": "rust_jsonschema",
    "pdf_backend": "typst",
    "html_parser_backend": "beautifulsoup",
    "dns_backend": "python_dnspython",
    "http_probe_backend": "python_requests",
    "crawler_backend": "python_crawler",
    "fallback_policy": "explicit",
    "record_provenance": true,
    "record_metrics": true,
    "native_subprocess_timeout_seconds": 120
  },
  "AIReviewConfig": {
    "provider": "ollama",
    "base_url": "http://127.0.0.1:11434",
    "model": "qwen3.5:9b-q4_K_M",
    "strategy": "staged_full_coverage",
    "mode": "balanced",
    "timeout_seconds": 3600,
    "temperature": 0.2,
    "top_p": 0.9,
    "keep_alive": "30m",
    "max_parallel_requests": 1,
    "stage_num_ctx": 32768,
    "stage_num_predict": 4096,
    "synthesis_num_ctx": 65536,
    "synthesis_num_predict": 8192,
    "cross_num_ctx": 65536,
    "cross_num_predict": 8192,
    "final_num_ctx": 65536,
    "final_num_predict": 8192,
    "stage_think": false,
    "cross_think": false,
    "final_think": false,
    "analyze_screenshots": false,
    "resume_work": true,
    "require_complete_coverage": true,
    "stage_minimum_response_chars": 250,
    "minimum_response_chars": 3000,
    "max_attempts": 2
  }
}
